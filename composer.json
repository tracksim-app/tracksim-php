{
    "name": "tracksim/tracksim-php",
    "description": "Official PHP and Laravel client for the TrackSim API and webhooks",
    "keywords": ["tracksim", "ets2", "ats", "euro-truck-simulator", "american-truck-simulator", "vtc", "api", "sdk", "webhooks", "laravel"],
    "type": "library",
    "license": "MIT",
    "homepage": "https://docs.tracksim.app",
    "support": {
        "issues": "https://github.com/tracksim-app/tracksim-php/issues",
        "source": "https://github.com/tracksim-app/tracksim-php",
        "docs": "https://docs.tracksim.app"
    },
    "authors": [
        {
            "name": "Omnibyte Technologies Limited",
            "homepage": "https://tracksim.app"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5|^11.5|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "TrackSim\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TrackSim\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TrackSim\\Laravel\\TrackSimServiceProvider"
            ],
            "aliases": {
                "TrackSim": "TrackSim\\Laravel\\Facades\\TrackSim"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "pint"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
